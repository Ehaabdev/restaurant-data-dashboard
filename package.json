{
  "name": "restaurant-dashboard",
  "version": "0.0.0",
  "scripts": {
    "start": "concurrently -n api,web -c blue,green \"npm:api\" \"npm:web\"",
    "start:slow": "concurrently -n api,web -c blue,green \"npm:api:slow\" \"npm:web\"",
    "api": "tsx server/main.ts",
    "api:slow": "tsx server/main.ts --latency 1500 --error-rate 0.15",
    "web": "ng serve",
    "build": "ng build",
    "generate:data": "tsx server/generate-data.ts",
    "data:reset": "node -e \"require('fs').rmSync('server/data/overrides.json', { force: true })\"",
    "test": "npm run test:api && npm run test:web",
    "test:api": "node --import tsx --test \"server/**/*.test.ts\"",
    "test:web": "ng test --watch=false",
    "typecheck": "tsc -p server/tsconfig.json && tsc -p tsconfig.app.json --noEmit",
    "ng": "ng",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"server/**/*.ts\" \"shared/**/*.ts\""
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "chart.js": "^4.6.1",
    "express": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.28",
    "@angular/cli": "^21.2.28",
    "@angular/compiler-cli": "^21.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  }
}
